# Python cache and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Local Python environments
.venv/
venv/

# Environment & Secrets
.env
.env.*
!.env.example
*.token
*secret*
*credential*
vault-token
vault-creds.json

# Whitelist markdown documentation
!docs/*.md

# Private key material and generated PKI output must never be committed
*.key
*.pem
*.crt
*.csr
*.p12
*.pfx
*.jks
*.srl
pki/out/
pki/out-clean/
tests/work/
tests/.work-run.*/

# System & OS
.DS_Store
Thumbs.db

# IDE & Editors
.vscode/
.idea/
*.swp
*~

# Temporary & Logs
*.log
tmp/
scratch/
